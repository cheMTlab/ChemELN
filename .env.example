# CheMTlab configuration. Copy to .env; install.sh generates this for you.
# NEVER commit .env.

# --- Site ---
CHEMTLAB_DOMAIN=localhost
CHEMTLAB_ADMIN_EMAIL=admin@example.org
DJANGO_DEBUG=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Database (PostgreSQL + RDKit cartridge) ---
POSTGRES_DB=chemtlab
POSTGRES_USER=chemtlab
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://chemtlab:change-me@db:5432/chemtlab

# --- Background jobs ---
REDIS_URL=redis://redis:6379/0

# --- Email (password resets, reminders) ---
EMAIL_URL=consolemail://
DEFAULT_FROM_EMAIL=chemtlab@example.org

# --- Institutional single sign-on (OIDC). Leave empty to disable. ---
# Works with Azure AD / Entra ID, Keycloak, Google Workspace, SATOSA/eduGAIN proxies.
OIDC_PROVIDER_NAME=
OIDC_SERVER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# --- Privacy switches (all off by default: no data leaves the server) ---
CHEMTLAB_ALLOW_EXTERNAL_LOOKUPS=false
CHEMTLAB_AI_PROVIDER=

# --- Inventory ---
# instance = everyone signed in can find any container ("who has X?"); group = own groups only
CHEMTLAB_INVENTORY_VISIBILITY=instance
CHEMTLAB_CURRENCY=EUR
CHEMTLAB_BARCODE_PREFIX=CT

# --- Structure editor: ketcher (default, open source) | marvinjs (needs a ChemAxon licence) ---
STRUCTURE_EDITOR=ketcher

# --- Backups (restic) ---
# Local folder on the server that receives backups (mount a NAS share here), or an S3 URL
# such as s3:https://s3.example.org/chemtlab-backups (also set AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY).
CHEMTLAB_BACKUP_DIR=./backups
RESTIC_REPOSITORY=/backups/restic
# KEEP A COPY OF THIS PASSWORD OUTSIDE THE SERVER. Without it, backups cannot be restored.
RESTIC_PASSWORD=change-me
BACKUP_HOUR=02
BACKUP_KEEP_DAILY=14
BACKUP_KEEP_WEEKLY=8
BACKUP_KEEP_MONTHLY=12
